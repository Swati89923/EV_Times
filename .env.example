# Copy this file to .env in the project root before running:
#   docker compose up --build
# docker compose automatically loads a .env file from the same directory
# as docker-compose.yml.

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
DB_NAME=evtimesdb
DB_USERNAME=evtimes
DB_PASSWORD=changeme_use_a_real_password
DB_ROOT_PASSWORD=changeme_use_a_real_root_password
DDL_AUTO=update
SHOW_SQL=false

# ---------------------------------------------------------------
# News ingestion (https://newsapi.org — free tier works for dev)
# ---------------------------------------------------------------
NEWS_API_KEY=
NEWS_FETCH_ENABLED=true
NEWS_FETCH_CRON=0 0 * * * *

# ---------------------------------------------------------------
# JWT — generate with: openssl rand -base64 48
# ---------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# ---------------------------------------------------------------
# CORS — the frontend origin the backend should accept requests from
# ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------
# Frontend build-time API URL (baked into the static bundle — see
# frontend/ev-times-frontend/Dockerfile for why this can't be a
# runtime env var for a static build)
# ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------
# AI (Spring AI + Ollama) — only needed for AI chat/summary features
# ---------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b

LOG_LEVEL=INFO
