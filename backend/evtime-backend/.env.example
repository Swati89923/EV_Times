# Copy to .env and fill in real values. Spring Boot does not read .env files
# on its own — export these as real environment variables, or use them with
# docker-compose / your process manager. See application.properties for how
# each one is consumed.

DB_URL=jdbc:mysql://localhost:3306/evtimesdb
DB_USERNAME=root
DB_PASSWORD=changeme

NEWS_API_KEY=
NEWS_FETCH_ENABLED=true
NEWS_FETCH_CRON=0 0 * * * *

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

CORS_ALLOWED_ORIGINS=http://localhost:5173

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

REDIS_HOST=localhost
REDIS_PORT=6379
